# Dedicated CONNX REST service origin (do not use a Web Admin URL).
CONNX_BASE_URL=https://your-connx-rest-endpoint
CONNX_VERIFY_TLS=true
# Development only: permits the login screen to disable certificate checks.
CONNX_ALLOW_INSECURE_TLS=false
CONNX_REQUEST_TIMEOUT=30
LOGIN_ATTEMPTS_PER_PRINCIPAL=10
LOGIN_ATTEMPTS_PER_SOURCE=30
LOGIN_ATTEMPT_WINDOW_SECONDS=900
FLASK_SECRET_KEY=replace-with-a-long-random-value
# Alternatively, mount the Flask signing key and set FLASK_SECRET_KEY_FILE.
# CONNX bearer tokens are stored in SQLite under opaque browser session handles.
CONNX_SESSION_TTL_SECONDS=3600
# Keep false for local HTTP only; production HTTPS deployments must set true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CONNX_ENVIRONMENT=development

# Production HTTP boundary. TRUSTED_HOSTS is a JSON list. Enable forwarded
# headers only behind one trusted proxy that overwrites them.
TRUSTED_HOSTS=[]
TRUST_PROXY_HEADERS=false
MAX_CONTENT_LENGTH=1048576
HSTS_MAX_AGE=31536000

# Optional non-secret Help & About metadata.
CONNX_APP_VERSION=Development
CONNX_APP_BUILD=Local
CONNX_DOCUMENTATION_URL=
CONNX_SUPPORT_URL=
CONNX_PRIVACY_URL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key
# Alternatively, mount the key as a file and set AZURE_OPENAI_API_KEY_FILE.
AZURE_OPENAI_DEPLOYMENT=your-model-deployment-name
# Set to entra to use DefaultAzureCredential/managed identity and omit the key.
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_ENTRA_SCOPE=https://ai.azure.com/.default

# Optional CONNX endpoint called immediately before an AI request. Leave blank
# until your CONNX server exposes a suitable read-only health endpoint.
CONNX_HEALTH_PATH=
CONNX_HEALTH_REQUIRED=false

# Maximum number of completed jobs included in one AI analysis (1-500).
AI_HISTORY_LIMIT=100
AI_BACKGROUND_THRESHOLD=200
AI_REQUESTS_PER_HOUR=10
AI_REQUESTS_PER_DAY=25
ANALYSIS_RETENTION_DAYS=30

# Optional controls applied before Data Sync history is sent to Azure OpenAI.
AI_REDACT_OBJECT_NAMES=false
AI_REDACT_ERROR_TEXT=false
# JSON array of regular expressions. Matches are replaced with [redacted].
AI_REDACTION_PATTERNS=[]

# Optional: override the default instance/connx_rest_app.db location.
# This database contains server-side CONNX bearer tokens and must remain private.
# ANALYSIS_DB_PATH=/var/lib/connx/connx_rest_app.db
